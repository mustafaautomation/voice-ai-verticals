# Local demo settings. Copy to .env. Nothing in this file is a real credential.
# Free tiers only: Vapi credits for voice, Groq or Gemini if you run live evals.
# Do not commit .env.

PORT=4317
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
DATABASE_PATH=./data/verticals.sqlite
SEED_ON_BOOT=true
# false on Vercel, where the CDN serves public/.
SERVE_STATIC=true

# Shared secret Vapi sends as x-vapi-secret. Use a long random string.
VAPI_WEBHOOK_SECRET=replace-with-a-long-random-string
# Private key for `npm run vapi:sync` and for signing browser-call tokens.
VAPI_API_KEY=
VAPI_ORG_ID=
# Fallback handed out only after the call-limit check.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
# Second assistant for Lindenmere Primary Care. Leave empty until `VERTICAL=clinic npm run vapi:sync`.
VAPI_CLINIC_ASSISTANT_ID=
# Wrenline card support. Leave empty until `VERTICAL=fintech npm run vapi:sync`.
VAPI_FINTECH_ASSISTANT_ID=
# groq (default, Vapi built-in Groq, no extra credential) or google.
VAPI_MODEL_PROVIDER=groq
VAPI_MODEL=openai/gpt-oss-120b
# Public URL Vapi can reach. Tool URLs are {PUBLIC_BASE_URL}/v/hvac/vapi/...
PUBLIC_BASE_URL=http://127.0.0.1:4317
# Comma-separated. Defaults to PUBLIC_BASE_URL plus the two planned demo origins.
WEB_CALL_ORIGINS=
WEB_CALL_LIMIT_PER_VISITOR=3
WEB_CALL_LIMIT_PER_DAY=40
WEB_CALL_TOKEN_TTL_SECONDS=30
# true only behind a proxy that sets x-real-ip / x-forwarded-for (Vercel).
TRUST_PROXY_HEADERS=false
# host=verticalId pairs. hvac.quvantic.com serves the HVAC pages at /.
VERTICAL_HOSTS=hvac.quvantic.com=hvac,hvac.localhost=hvac,clinic.quvantic.com=clinic,clinic.localhost=clinic,fintech.quvantic.com=fintech,fintech.localhost=fintech

# mock stores texts in SQLite and shows them on the board. http POSTs JSON to your URL.
# This repo never calls a paid SMS API.
SMS_PROVIDER=mock
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_FROM_NUMBER=+12185550148
TRANSFER_NUMBER=+12185550148
ON_CALL_NUMBER=+12185550190

# Optional. `npm run eval:live` only. CI does not need these.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
