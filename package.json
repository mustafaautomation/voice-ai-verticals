{
  "name": "voice-ai-verticals",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio demo: multi-vertical voice AI agents. First vertical is Fennwick Comfort Co., a fictional HVAC dispatcher.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "eval": "tsx src/evals/cli.ts",
    "eval:live": "tsx src/evals/live.ts",
    "vapi:sync": "tsx scripts/vapi-sync.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "author": "Muhammad Mustafa",
  "license": "MIT",
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.11",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "luxon": "^3.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.2"
  }
}
